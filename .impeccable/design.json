      "css": ".ds-text{min-height:44px;display:inline-flex;align-items:center;gap:10px;border:0;background:none;padding:7px 0;font:12px/1.7 'Segoe UI','Microsoft YaHei',sans-serif;color:var(--accent-text,#00749e);cursor:pointer}.ds-text svg{transition:transform .3s cubic-bezier(.16,1,.3,1)}.ds-text:hover{text-decoration:underline}.ds-text:hover svg{transform:translate(2px,-2px)}.ds-text:focus-visible{outline:2px solid var(--sky-11,#00749e);outline-offset:4px;border-radius:3px}.ds-text:active{color:var(--sky-12,#1d3e56)}@media(prefers-reduced-motion:reduce){.ds-text svg{transition:none}}"
    },
    {
      "name": "桌面快捷图标",
      "kind": "nav",
      "refersTo": "desktop-file",
      "description": "中文名称与 Pixel 短标签共同标明档案；当前页使用透白内边框。",
      "html": "<nav class=\"ds-shelf\" aria-label=\"主导航\"><a class=\"ds-file\" href=\"#plans\" aria-current=\"page\"><span><svg width=\"30\" height=\"26\" viewBox=\"0 0 30 26\" aria-hidden=\"true\"><path d=\"M2 7V2h12v5h14v17H2z\" fill=\"#f3d8e6\" stroke=\"#b18ba5\" stroke-width=\"2\"/></svg></span><span>策划案作品集</span><small>DESIGN DOCS</small></a></nav>",
      "css": ".ds-shelf{display:flex;flex-direction:column;align-items:center;gap:8px;padding:0}.ds-file{position:relative;display:flex;flex-direction:column;justify-content:center;gap:7px;align-items:center;width:120px;min-height:100px;border-radius:4px;padding:12px 4px;transition:transform .2s var(--ease)}.ds-file::before{content:'';position:absolute;inset:3px 4px;pointer-events:none;border:1px dashed transparent;border-radius:4px;background:transparent;transition:background .2s,border-color .2s}.ds-file:hover{transform:translateY(-3px)}.ds-file:hover::before{border-color:rgba(255,255,255,.8);background:rgba(255,255,255,.12)}.ds-file:active{transform:translateY(1px)}.ds-file[aria-current=page]::before{border-color:rgba(71,133,171,.5);background:rgba(239,250,255,.3);box-shadow:inset 0 0 0 1px rgba(255,255,255,.32)}.ds-file>span:nth-child(2){font-size:12px;white-space:nowrap;line-height:1.4;position:relative;padding:2px 5px;border-radius:2px;background:rgba(242,250,255,.6);color:#354f64}.ds-file small{position:relative;font-size:11px;color:var(--ambient-foreground,#334f64);line-height:1.3;margin-top:-5px}.ds-file{text-decoration:none;font-family:sans-serif}.ds-file:focus-visible{outline:2px solid #00749e;outline-offset:4px}"
    },
    {
      "name": "Demo 分类标签",
      "kind": "chip",
      "refersTo": "demo-chip",
      "description": "仅展示原型分类，没有筛选行为。",
      "html": "<span class=\"ds-chip\">玩法实验</span>",
      "css": ".ds-chip{display:inline-block;background:var(--pink-3,#fee9f5);color:var(--memo-foreground,#75475f);padding:3px 7px;border-radius:3px;font:10px/1.7 'Segoe UI','Microsoft YaHei',sans-serif}"
    },
    {
      "name": "毛玻璃窗口",
      "kind": "card",
      "refersTo": "glass-window",
      "description": "Sky alpha 标题栏与半透明玻璃框。装饰窗控件为非交互图形。",
      "html": "<div class=\"ds-glass\"><div class=\"ds-title\"><span>portfolio.journal</span></div><div class=\"ds-window-content\">作品手账</div></div>",
      "css": ".ds-glass{position:relative;background:radial-gradient(ellipse at var(--light-x,22%) var(--light-y,0%),rgba(255,255,255,.45),transparent 62%),linear-gradient(135deg,rgba(255,255,255,.25),rgba(255,255,255,.04) 38%,rgba(202,228,246,.18) 66%,rgba(255,255,255,.23)),var(--glass);border:1px solid var(--glass-edge);border-bottom-color:rgba(139,181,207,.52);border-right-color:rgba(173,210,232,.65);border-radius:11px;box-shadow:inset 0 1px 0 rgba(255,255,255,.94),inset 1px 0 0 rgba(255,255,255,.64),inset 0 -1px 0 rgba(255,255,255,.45),var(--glass-shadow);backdrop-filter:blur(22px) saturate(1.18);-webkit-backdrop-filter:blur(22px) saturate(1.18);overflow:hidden}.ds-glass::before{content:'';position:absolute;inset:3px;border:1px solid rgba(255,255,255,.32);border-radius:8px;pointer-events:none;z-index:6}.ds-title{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:38px;padding:8px 12px;font-size:13px;color:var(--glass-foreground,#39566c);background:linear-gradient(180deg,rgba(255,255,255,.55),rgba(200,230,247,.14));border-bottom:1px solid rgba(128,171,198,.2);box-shadow:0 1px 0 rgba(255,255,255,.5);line-height:1.3;text-shadow:0 1px 0 rgba(255,255,255,.8)}.ds-window-content{padding:16px;font:14px/1.7 sans-serif}.ds-glass{color:#334657}.ds-title{font-family:Pixel,Fusion,monospace}"
    },
    {
      "name": "身份便签",
      "kind": "custom",
      "refersTo": "memo",
      "description": "粉色虚线纸、半透明胶带与小角度旋转。",
      "html": "<div class=\"ds-memo\"><span class=\"ds-tape\" aria-hidden=\"true\"></span><strong>姓名待填写</strong><p>从设计文档到可玩的原型。<br>把规则、实验与迭代，放在同一页。</p></div>",
      "css": ".ds-memo{position:relative;max-width:440px;background-image:var(--paper-grain,none),linear-gradient(165deg,rgba(255,255,255,.48),transparent 70%,rgba(185,113,147,.08));background-color:var(--memo);color:var(--memo-foreground);margin:25px 12px 29px 0;padding:24px 27px 22px;transform:rotate(-1.5deg);box-shadow:0 1px 1px rgba(149,100,127,.12),2px 6px 9px -5px rgba(118,79,102,.24),7px 15px 18px -16px rgba(118,79,102,.32);border:1px solid rgba(223,180,204,.4);border-top-color:rgba(255,255,255,.8)}.ds-memo::after{content:'';position:absolute;bottom:-1px;right:-1px;width:22px;height:22px;background:linear-gradient(135deg,transparent 48%,#ddb9ca 49%,#f8dce9 54%,#fdebf3 69%,var(--paper) 71%);pointer-events:none}.ds-tape{position:absolute;left:calc(50% - 40px);top:-12px;width:80px;height:25px;background:var(--paper-grain,none),linear-gradient(0deg,rgba(177,209,221,.62),rgba(213,234,240,.72));box-shadow:inset 0 1px 0 rgba(255,255,255,.5);transform:rotate(-5deg);clip-path:polygon(0 4%,4% 10%,1% 21%,4% 35%,0 48%,3% 60%,1% 74%,4% 85%,0 96%,100% 100%,96% 86%,99% 75%,96% 62%,100% 47%,97% 35%,100% 19%,96% 8%,100% 0);pointer-events:none}.ds-memo{margin:24px 8px}.ds-memo strong{font:400 20px/1.7 Fusion,sans-serif}.ds-memo p{margin:12px 0 0;font:13px/1.9 sans-serif}"
    },
    {
      "name": "装订纸页",
      "kind": "custom",
      "description": "实心奶油白阅读面，用装订孔和粉色细线建立手账材质。",
      "html": "<div class=\"ds-paper\"><h2>策划案作品集</h2><p>设计目标、规则与验证过程。</p></div>",
      "css": ".ds-paper{position:relative;min-height:200px;margin-top:5px;background-image:var(--paper-grain,none),linear-gradient(110deg,rgba(224,217,201,.13),transparent 13%,rgba(255,255,255,.45) 45%,rgba(225,219,204,.06));background-color:var(--paper);border:1px solid rgba(240,235,223,.9);border-radius:3px 4px 5px 3px;padding:32px 34px 24px 53px;box-shadow:inset 1px 0 0 #fff,inset 0 -1px 0 rgba(177,170,151,.08),var(--paper-shadow);z-index:1}.ds-paper::before{content:'';position:absolute;left:11px;top:30px;bottom:25px;width:16px;background:radial-gradient(circle at 8px 12px,#9fb6c5 0 2px,#c7d7df 3px 4px,#f5f2e9 4.5px 5px,transparent 6px);background-size:16px 58px}.ds-paper::after{content:'';position:absolute;left:38px;top:18px;bottom:18px;width:1px;background:var(--pink-6)}.ds-paper h2{margin:0;font:400 30px/1.4 Fusion,sans-serif}.ds-paper p{font:12px/1.7 sans-serif}"
    },
    {
      "name": "文档封面",
      "kind": "card",
      "description": "纸页条目的轻微倾斜封面，悬停转正并出现纸影。",
      "html": "<div class=\"ds-cover\"><span>SYSTEM<br>DESIGN</span><small>DESIGN DOC<br>文档封面展示位</small></div>",
      "css": ".ds-cover{position:relative;width:126px;min-height:155px;padding:17px 13px;background:var(--sky-3,#e1f6fd);border:1px solid var(--sky-6,#a9daed);border-radius:2px;transform:rotate(-2deg);overflow:hidden;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s;color:var(--foreground,#334657)}.ds-cover:before{content:'';position:absolute;top:0;bottom:0;left:9px;width:1px;background:var(--sky-7,#8dcae3)}.ds-cover>span{display:block;margin-left:7px;font:23px/1.05 Pixel,Fusion,monospace;letter-spacing:.04em}.ds-cover small{position:absolute;bottom:15px;left:20px;right:8px;font:9px/1.7 'Segoe UI','Microsoft YaHei',sans-serif;color:var(--muted-foreground,#596774)}.ds-cover:hover{transform:rotate(0);box-shadow:0 6px 12px rgba(71,99,125,.12)}@media(prefers-reduced-motion:reduce){.ds-cover{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "天空上的作品手账",
    "overview": "淡蓝像素云铺满屏幕，毛玻璃窗口承载导航与工具，奶油色纸页承载正文。桌面上的文件架、手账、便签和像素贴纸形成轻松的游戏策划工作台。像素轮廓集中在标题、短英文标签和装饰，长段说明保持清晰的无衬线字形。\n\n这套系统服务于招聘者阅读简历、策划文档和试玩原型。错落与倾斜属于桌面构图；手机将入口和内容按阅读顺序展开。当前内容来自 `dist/content.js` 的待填写框架，资料、链接和成果状态由实际内容决定。",
    "keyCharacteristics": [
      "全屏淡蓝像素云，毛玻璃 HUD 窗口与奶油色阅读纸页。",
      "中文像素标题、英文像素标签与清晰的无衬线正文。",
      "粉色便签、淡紫纸签、装订孔和原创像素贴纸。",
      "桌面窗口错落叠放，手机使用原生单列阅读布局。",
      "FX 本地偏好、系统减少动态效果与后台暂停共同控制天空和粒子。"
    ],
    "rules": [
      {
        "name": "The Paper Contrast Rule",
        "body": "正文放在纸页或明确的窗口内容面上；天空透光留给玻璃边框与工具区域。",
        "section": "colors"
      },
      {
        "name": "The Short Pixel Rule",
        "body": "像素字体用于标题、短标签与短句；策划规则、简历经历和详情字段使用正文栈。",
        "section": "typography"
      },
      {
        "name": "The Sky Layer Rule",
        "body": "根元素保留固定天空渐变；body 使用透明背景与隔离堆叠上下文。CSS 天空在 z-index 0，WebGL 天空在 1，页面工具与主工作台在 2，粒子在 8。Toast 在 30，原生模态 dialog 使用浏览器 top layer。天空不依赖负 z-index。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 沿用 Sky / Mauve / Pink 语义映射，并保留作者定义的奶油纸、莓灰文字与雾白玻璃材质。",
      "**Do** 将正文放在清晰纸页上，将透光和模糊用于窗口外框与工具面。",
      "**Do** 保持标题、短标签和贴纸的像素轮廓，让长段正文使用无衬线字体。",
      "**Do** 保持根天空、CSS 天空、WebGL 天空和页面内容的明确层序。",
      "**Do** 遵循 FX、减少动态效果、后台暂停、键盘焦点与待添加状态。",
      "**Do** 在手机按阅读顺序展开窗口，保留至少 44px 的操作高度和全部内容路由。"
    ],
    "donts": [
      "**Don't** 恢复旧的深色 Sage / Jade / Mint 庭院视觉或将未加载的旧资产写成当前组件。",
      "**Don't** 用不透明 body 背景盖住天空，或把天空放入负 z-index 层。",
      "**Don't** 给装饰窗口控件和贴纸添加虚假的操作语义。",
      "**Don't** 用像素字体排长段策划正文，或让动效成为访问内容的前提。",
      "**Don't** 将占位文案、空链接或装饰资产描述成真实项目、成绩与经历。"
    ]
  }
}
