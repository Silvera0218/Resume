  "components": [
    {
      "name": "主操作按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "用于已有试玩、附件和联系操作；空链接使用明确待添加状态。",
      "html": "<button class=\"ds-btn ds-primary\">在线试玩</button>",
      "css": ".ds-btn{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:10px 16px;border:1px solid var(--border,#8dcae3);border-radius:6px;font:12px/1.5 'Segoe UI','Microsoft YaHei',sans-serif;cursor:pointer;transition:background .2s,transform .2s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{background:var(--sky-4,#d1f0fa);transform:translateY(-2px)}.ds-btn:active{background:var(--sky-5,#bee7f5);transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--sky-11,#00749e);outline-offset:4px}.ds-btn:disabled{background:var(--mauve-3,#f2eff3);color:#68717b;cursor:default;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-btn{transition:none}}.ds-primary{background:var(--primary,#7ce2fe);color:var(--primary-foreground,#1d3e56);border-color:var(--sky-8,#60b3d7)}.ds-primary:hover{background:var(--sky-10,#74daf8)}"
    },
    {
      "name": "普通按钮",
      "kind": "button",
      "refersTo": "button",
      "description": "浅蓝操作面，最小高度 44px。",
      "html": "<button class=\"ds-btn ds-default\">关闭详情</button>",
      "css": ".ds-btn{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:10px 16px;border:1px solid var(--border,#8dcae3);border-radius:6px;font:12px/1.5 'Segoe UI','Microsoft YaHei',sans-serif;cursor:pointer;transition:background .2s,transform .2s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{background:var(--sky-4,#d1f0fa);transform:translateY(-2px)}.ds-btn:active{background:var(--sky-5,#bee7f5);transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--sky-11,#00749e);outline-offset:4px}.ds-btn:disabled{background:var(--mauve-3,#f2eff3);color:#68717b;cursor:default;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-btn{transition:none}}.ds-default{background:var(--sky-3,#e1f6fd);color:var(--foreground,#334657)}"
    },
